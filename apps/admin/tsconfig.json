{
  "extends": "@patriothacks/config/tsconfig.nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    // @patriothacks/database ships source whose relative imports carry an
    // explicit .ts extension, so consumers have to allow it too.
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "cloudflare-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", ".open-next", ".wrangler"]
}
