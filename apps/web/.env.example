# Supabase credentials for the /volunteer and /judge application forms.
#
# Copy this file to `.env` (gitignored) for local development, and set the
# same two variables in your Vercel/Netlify project settings for production.
#
# Find both values in the Supabase dashboard:
#   Project Settings -> API -> Project URL and the anon/public key.
#
# The anon key is safe to expose — it ships in the browser bundle either
# way, and supabase/schema.sql restricts it to INSERT-only on the two
# application tables. Never put the service_role key here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
