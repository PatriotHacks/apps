# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Two URLs, deliberately. They point at the same database through different
# front doors, and using the wrong one is a real source of bugs.
#
# DATABASE_URL — Supavisor transaction-mode pooler, port 6543.
#   Used by the apps at runtime (Cloudflare Workers). Transaction mode hands a
#   backend connection back to the pool after every transaction, which is what
#   makes a large number of short-lived Worker invocations viable.
#   It does NOT preserve session state between statements, so prepared
#   statements, LISTEN/NOTIFY, advisory locks and DDL are unsafe here.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"

# DIRECT_DATABASE_URL — direct/session connection, port 5432.
#   Used by drizzle-kit for generate/migrate, and by anything else that issues
#   DDL. Migrations need a stable session: transaction-mode pooling can split a
#   migration across backends and leave the schema half-applied.
#   Never point the running apps at this — it exhausts connections.
DIRECT_DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project URL and anon key are public by design — they are shipped to the
# browser and are only safe because RLS policies are the actual boundary.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Service role key bypasses RLS entirely. Server-only, admin console paths
# only, and never in an app that renders for an unauthenticated visitor.
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# Resend API key. Local development sends into the Supabase stack's Inbucket
# instead, so this can stay empty until a real send is needed.
RESEND_API_KEY=""

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Comma-separated list of providers that must be enabled in the Supabase
# dashboard. Drives which login buttons the platform renders, so the UI never
# offers a provider the backend will reject.
# Recognised values: password, magic_link, google, github. Anything else is
# ignored rather than rendered as a button that cannot work.
NEXT_PUBLIC_AUTH_PROVIDERS="password,magic_link,google,github"
