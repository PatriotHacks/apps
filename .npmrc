# Next.js and ESLint resolve plugins from the app root, so hoist those to the
# workspace root rather than leaving them in pnpm's isolated store layout.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=@types/*

# Peer ranges across Next, React and the OpenNext adapter drift constantly.
# Warn instead of failing the install.
strict-peer-dependencies=false
